# 텔레그램 봇 토큰 (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=

# 알림 받을 채팅 ID (@userinfobot 등으로 확인)
TELEGRAM_CHAT_ID=

# 상태 저장 디렉터리 (Railway Volume 마운트 경로. 로컬은 비워두면 ./data)
DATA_DIR=

# --- 멀티 리전 (권역별로 서비스를 나눠 띄울 때만) ---
# 첫 부팅 감시 권역. 콤마로 여러 개 (예: 경기권,강원·충청권). 비우면 서울·인천권.
# 권역명에 가운뎃점(·)이 들어가므로 구분자는 콤마만 쓴다.
# ⚠ '기본값'일 뿐이다 — DATA_DIR/settings.json 이 이미 있으면 저장본이 이긴다.
#   즉 운영 중인 서비스에 이 값을 바꿔 넣어도 감시 조건은 안 바뀐다(설정 화면에서 바꿀 것).
REGION_FILTER=

# 서비스 라벨. 텔레그램 알림 맨 앞과 웹 헤더/탭 제목에 [라벨] 로 붙는다 (예: 경기).
# 여러 서비스가 같은 채팅방을 쓸 때 발신 서비스를 구분한다. 비우면 아무것도 안 붙는다.
SERVICE_LABEL=

# 수집 대상 시즌(연도). 사이트 목록 API 가 season 파라미터를 요구한다.
# 연도가 바뀌면 이 값만 교체하면 된다. (비우면 기본 2026)
SEASON_YEAR=

# 절전 방지 자체 핑 대상. Railway 는 RAILWAY_PUBLIC_DOMAIN 을 자동 주입하므로
# 보통 비워 둬도 된다. 다른 호스팅이면 공개 URL 을 적는다 (예: https://my-app.example.com)
KEEPALIVE_URL=

# --- 감시 루프 안전장치 (비우면 기본값 사용 — 평소 건드릴 필요 없다) ---
# 순서가 중요하다: 스크래퍼(90초) < 사이클(4분) < 죽은 락(5분) < 워치독(30분)
#
# 스크래퍼 1회 상한 (밀리초, 기본 90000) — 기동·접속·수집을 통틀어
SCRAPE_TIMEOUT_MS=
# 한 사이클 상한 (분, 기본 4) — 스크래퍼 상한 2회분보다 커야 한다
CYCLE_TIMEOUT_MIN=
# '진행 중' 플래그가 이만큼 잡혀 있으면 죽은 락으로 보고 강제 해제 (분, 기본 5)
# 사이클 상한보다 커야 한다 — 작게 줘도 max(값, 사이클상한+1분) 으로 보정된다
STALE_LOCK_MIN=
# 워치독 점검 주기 (분, 기본 1)
WATCHDOG_TICK_MIN=
# 이만큼 수집 활동이 없으면 루프 자동 재시작 (분, 기본 30 · 실제로는 수집간격×3 과 큰 쪽)
WATCHDOG_STALL_MIN=
# 자체 keep-alive 핑 간격 (기본 5)
KEEPALIVE_MIN=

# --- 프로세스 자체 재기동 (⑦⑧⑨ · 비우면 기본값) ---
# ⚠ 종료 코드는 0 이 아니어야 한다. Railway 기본 재시작 정책이 ON_FAILURE 라서
#   exit(0) 은 정상 종료로 보고 컨테이너를 다시 띄우지 않는다(= 감시가 죽는다).
#   정책을 ALWAYS 로 바꿨을 때만 0 으로 되돌린다. (기본 1)
RESTART_EXIT_CODE=
# 예방 재기동 시각 (KST 기준 0~23, 기본 4 · -1 이면 비활성)
MAINTENANCE_HOUR=
# 정비 창 (분, 기본 20) — 수집 중이면 이 창 안에서 다음 분으로 미룬다
MAINTENANCE_WINDOW_MIN=
# 갓 뜬 프로세스는 예방 재기동 대상에서 제외 (분, 기본 60)
MAINTENANCE_MIN_UPTIME_MIN=
# 이만큼 연속 실패하면 스스로 재기동 + 텔레그램 알림 (기본 5)
FAIL_RESTART_STREAK=
# 하루 기동 횟수가 이 수를 넘으면 '수동 확인 필요' 경보 (기본 3)
RESTART_ALERT_PER_DAY=

# 텔레그램 봇 토큰 (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=

# 알림 받을 채팅 ID (@userinfobot 등으로 확인)
TELEGRAM_CHAT_ID=

# 상태 저장 디렉터리 (Railway Volume 마운트 경로. 로컬은 비워두면 ./data)
DATA_DIR=

# 수집 대상 시즌(연도). 사이트 목록 API 가 season 파라미터를 요구한다.
# 연도가 바뀌면 이 값만 교체하면 된다. (비우면 기본 2026)
SEASON_YEAR=

# 절전 방지 자체 핑 대상. Railway 는 RAILWAY_PUBLIC_DOMAIN 을 자동 주입하므로
# 보통 비워 둬도 된다. 다른 호스팅이면 공개 URL 을 적는다 (예: https://my-app.example.com)
KEEPALIVE_URL=

# --- 감시 루프 안전장치 (비우면 기본값 사용 — 평소 건드릴 필요 없다) ---
# 순서가 중요하다: 스크래퍼(90초) < 사이클(4분) < 죽은 락(5분) < 워치독(30분)
#
# 스크래퍼 1회 상한 (밀리초, 기본 90000) — 기동·접속·수집을 통틀어
SCRAPE_TIMEOUT_MS=
# 한 사이클 상한 (분, 기본 4) — 스크래퍼 상한 2회분보다 커야 한다
CYCLE_TIMEOUT_MIN=
# '진행 중' 플래그가 이만큼 잡혀 있으면 죽은 락으로 보고 강제 해제 (분, 기본 5)
# 사이클 상한보다 커야 한다 — 작게 줘도 max(값, 사이클상한+1분) 으로 보정된다
STALE_LOCK_MIN=
# 워치독 점검 주기 (분, 기본 1)
WATCHDOG_TICK_MIN=
# 이만큼 수집 활동이 없으면 루프 자동 재시작 (분, 기본 30 · 실제로는 수집간격×3 과 큰 쪽)
WATCHDOG_STALL_MIN=
# 연속 실패가 이 횟수를 넘으면 다음 시도까지의 간격을 2배씩 늘린다 (기본 5)
# 실패가 이어지는 동안의 재시도 자체가 메모리 압박이라 물러서기 위한 것이다
BACKOFF_AFTER_FAILS=
# 백오프로 늘어날 수 있는 최대 간격 (분, 기본 60)
BACKOFF_MAX_MIN=

# --- 프로세스 자가 재기동 (OOM 대비 · 위 장치들은 루프만 살린다) ---
# 재기동은 process.exit(1) 이고, Railway 재시작 정책(ON_FAILURE)이 새 컨테이너를 띄운다.
#
# 새벽 정기 재기동 시각 (KST 0~23, 기본 4). 범위 밖 값(예: -1)을 주면 끈다.
# 매일 한 번 쌓인 메모리를 0 으로 되돌린다. 텔레그램은 보내지 않는다(새벽 소음 금지).
DAILY_RESTART_HOUR=
# 연속 실패가 이 횟수에 닿으면 프로세스를 버리고 다시 뜬다 (기본 5, 0 이면 끔)
# 텔레그램으로 ♻️ 알림이 나간다. 재기동 후에는 '다시 이 횟수만큼' 쌓여야 또 나간다.
SELF_RESTART_AFTER_FAILS=
# 하루 자가 재기동 상한 (기본 3). 넘기면 더 재기동하지 않고 🚨 경보만 하루 1회 보낸다.
# 세 번 다시 태어나도 안 고쳐지는 문제는 재기동으로 고쳐지지 않는다.
SELF_RESTART_MAX_PER_DAY=
# (검증용) 정기 재기동을 거는 창 — 정각 이후 몇 분까지인지 (기본 10)
DAILY_RESTART_WINDOW_MIN=
# (검증용) 정기 재기동에 필요한 최소 생존 시간 (분, 기본 15)
# 창보다 길어야 한다 — 기록이 유실돼도 같은 시간대에 두 번 나가지 않게 하는 안전핀
DAILY_RESTART_MIN_UPTIME_MIN=

# --- 메모리 ---
# Node 힙 상한 (MB, 기본 128). 컨테이너 메모리는 사실상 크로뮴이 쓴다(수집 1회 약 334MB).
# Node 실사용은 heapUsed 29MB 수준이라 128 이면 4배 이상 여유다.
# Railway 변수로 덮으면 재빌드 없이 적용된다. 로컬 실행에는 영향 없다(Dockerfile 전용).
NODE_MAX_OLD_SPACE_MB=
# 자체 keep-alive 핑 간격 (기본 5)
KEEPALIVE_MIN=

# 텔레그램 봇 토큰 (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=

# 알림 받을 채팅 ID (@userinfobot 등으로 확인)
TELEGRAM_CHAT_ID=

# 상태 저장 디렉터리 (Railway Volume 마운트 경로. 로컬은 비워두면 ./data)
DATA_DIR=

# 수집 대상 시즌(연도). 사이트 목록 API 가 season 파라미터를 요구한다.
# 연도가 바뀌면 이 값만 교체하면 된다. (비우면 기본 2026)
SEASON_YEAR=

# 절전 방지 자체 핑 대상. Railway 는 RAILWAY_PUBLIC_DOMAIN 을 자동 주입하므로
# 보통 비워 둬도 된다. 다른 호스팅이면 공개 URL 을 적는다 (예: https://my-app.example.com)
KEEPALIVE_URL=

# --- 감시 루프 안전장치 (비우면 기본값 사용 — 평소 건드릴 필요 없다) ---
# 순서가 중요하다: 스크래퍼(90초) < 사이클(4분) < 죽은 락(5분) < 워치독(30분)
#
# 스크래퍼 1회 상한 (밀리초, 기본 90000) — 기동·접속·수집을 통틀어
SCRAPE_TIMEOUT_MS=
# 한 사이클 상한 (분, 기본 4) — 스크래퍼 상한 2회분보다 커야 한다
CYCLE_TIMEOUT_MIN=
# '진행 중' 플래그가 이만큼 잡혀 있으면 죽은 락으로 보고 강제 해제 (분, 기본 5)
# 사이클 상한보다 커야 한다 — 작게 줘도 max(값, 사이클상한+1분) 으로 보정된다
STALE_LOCK_MIN=
# 워치독 점검 주기 (분, 기본 1)
WATCHDOG_TICK_MIN=
# 이만큼 수집 활동이 없으면 루프 자동 재시작 (분, 기본 30 · 실제로는 수집간격×3 과 큰 쪽)
WATCHDOG_STALL_MIN=
# 자체 keep-alive 핑 간격 (기본 5)
KEEPALIVE_MIN=
